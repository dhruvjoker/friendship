# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=run.py

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_key

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL (Render / Neon / Supabase / Railway)
DATABASE_URL=postgresql://user:password@host:5432/friendship_circle
# SQLite for local dev only:
# DATABASE_URL=sqlite:///friendship_app.db

# ── App URL ────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com

# ── Email (Resend — https://resend.com) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@your-domain.com
EMAIL_SUPPORT=support@your-domain.com

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_USERNAMES=youradminusername

# ── SocketIO CORS ──────────────────────────────────────────────────────────
SOCKETIO_CORS_ORIGINS=https://your-domain.com

# ── Clerk (optional, for social login) ────────────────────────────────────
CLERK_API_KEY=
CLERK_JWT_KEYS_URL=https://api.clerk.com/v1/jwks
CLERK_ISSUER=

# ── Razorpay (billing) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth social login (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Observability (optional) ───────────────────────────────────────────────
SENTRY_DSN=

# ── Rate limiting ──────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
